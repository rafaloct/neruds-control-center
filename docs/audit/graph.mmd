  end
  subgraph NAV["Navegação compartilhada"]
    NAVE["FN openManageEditor"]
    NAVD["FN openManageDetail"]
    PICK["COMPONENT NodePickerSheet"]
  end
  subgraph BRIDGE["API_ENDPOINT (api.neruds.org)"]
