  DETAIL -->|Editar: NAVIGATES_TO| FORM
  MOD -->|tap: NAVIGATES_TO| DETAIL
  MOD -->|Aprovar: CALLS| E7
  MON -->|Ver/Editar| NAVD
  MON --> NAVD
  MISS -->|Editar ficha| NAVE
  MISS -->|Vincular ficha| PICK
  OPP -->|Abrir ficha| NAVE
  NAVE -->|CALLS| E1
  NAVE -->|NAVIGATES_TO| FORM
  NAVD -->|CALLS| E1
  NAVD -->|NAVIGATES_TO| DETAIL
  PICK -->|CALLS| E1
  PICK -->|CALLS| E2
  SECTORS -->|CALLS| E1
  LIST -->|CALLS| E2
  DETAIL -->|CALLS| E3
  DETAIL -->|CALLS| E5
  FORM -->|CALLS| E3
  FORM -->|WRITES| E4
  FORM -->|CALLS| E5
  TAX -->|CALLS| E6
  USERS -->|CALLS| E8
  FORM -->|upload| E9
  E1 & E2 & E3 & E4 & E5 & E6 & E7 & E8 & E9 & E10 -->|DEPENDS_ON| DRUP
  classDef ext fill:#fee,stroke:#c00;
  classDef edge fill:#ffe9b8,stroke:#a80;
  class DRUP ext;
