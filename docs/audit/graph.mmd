%% Grafo funcional observado — NERUDS Control Center (auditoria 2026-11)
%% Tipos: AREA, SCREEN, ACTION, API_ENDPOINT, DATA_ENTITY, EXTERNAL_SERVICE
graph TD
  subgraph AREA_GESTAO["AREA Gestão"]
    SECTORS["SCREEN ManageSectorsPage"]
    LIST["SCREEN ManageListPage"]
    DETAIL["SCREEN ManageDetailPage"]
    FORM["SCREEN ManageFormPage (wizard/lista)"]
    TAX["SCREEN ManageTaxonomyPage"]
    MOD["SCREEN ManageModerationPage"]
    USERS["SCREEN ManageUsersPage"]
  end
  subgraph AREA_OBS["AREA Observação"]
    MON["SCREEN MonitoringPage"]
    MISS["SCREEN MissionPage"]
    OPP["SCREEN OpportunitiesPage"]
