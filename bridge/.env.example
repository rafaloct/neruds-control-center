NERUDS_PORTAL_URL=https://neruds.org
NERUDS_VPS_TAILSCALE_HOST=100.111.132.36
NERUDS_SESSION_IDLE_HOURS=8
NERUDS_ALLOWED_ORIGINS=https://largeo.tail2faed0.ts.net:8444

# Obrigatória em produção: chave Fernet para criptografar os cookies Drupal
# das sessões persistidas em data/sessions.sqlite3. Sem ela, uma chave
# efêmera é gerada e as sessões morrem a cada restart (comportamento antigo).
# Gerar: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NERUDS_SESSION_KEY=

# Poste.io / SMTP. NERUDS_SMTP_HOST e a identidade TLS/SNI.
# NERUDS_SMTP_CONNECT_HOST pode ser o IP Tailscale para evitar depender da rota publica.
NERUDS_SMTP_HOST=mail.neruds.org
NERUDS_SMTP_CONNECT_HOST=100.111.132.36
NERUDS_SMTP_PORT=25
NERUDS_SMTP_STARTTLS=true

# Em porta 25 para entrega a mailbox local, autenticacao pode ficar vazia.
# Se mudar para submission/587, configure usuario e senha.
NERUDS_SMTP_USER=
NERUDS_SMTP_PASSWORD=
NERUDS_SMTP_FROM=admin@neruds.org
NERUDS_SMTP_REVIEW_TO=admin@neruds.org

# Infra futura, separada do fluxo editorial.
NERUDS_SSH_USER=neruds-control
NERUDS_SSH_KEY_PATH=C:\Users\Rafael\.ssh\neruds_control_ed25519
NERUDS_AUDIT_DB=D:\AI-Shared\neruds-control-center\data\audit.sqlite3
