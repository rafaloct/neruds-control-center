# Configuracao do bridge NERUDS.
#
# Os valores reais do ambiente NERUDS ficam fora do Git:
# - desenvolvimento/operacao: arquivo .env local ao lado de main.py;
# - CI e este repositorio: GitHub Secrets (Settings > Secrets and variables > Actions).
# Nunca commitar o .env preenchido.

NERUDS_PORTAL_URL=https://neruds.org
NERUDS_VPS_TAILSCALE_HOST=100.x.y.z
NERUDS_SESSION_IDLE_HOURS=8
NERUDS_ALLOWED_ORIGINS=https://<host-app-web>.<tailnet>.ts.net:8444

# Poste.io / SMTP. NERUDS_SMTP_HOST e a identidade TLS/SNI.
# NERUDS_SMTP_CONNECT_HOST pode ser o IP Tailscale para evitar depender da rota publica.
NERUDS_SMTP_HOST=mail.example.org
NERUDS_SMTP_CONNECT_HOST=100.x.y.z
NERUDS_SMTP_PORT=25
NERUDS_SMTP_STARTTLS=true

# Em porta 25 para entrega a mailbox local, autenticacao pode ficar vazia.
# Se mudar para submission/587, configure usuario e senha.
NERUDS_SMTP_USER=
NERUDS_SMTP_PASSWORD=
NERUDS_SMTP_FROM=review-notify@example.org
NERUDS_SMTP_REVIEW_TO=review-notify@example.org

# Infra futura, separada do fluxo editorial.
NERUDS_SSH_USER=bridge-operator
NERUDS_SSH_KEY_PATH=C:\Users\<operador>\.ssh\bridge_ed25519
NERUDS_AUDIT_DB=C:\caminho\para\neruds-control-center\data\audit.sqlite3
